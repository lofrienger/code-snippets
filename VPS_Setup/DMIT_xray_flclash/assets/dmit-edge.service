[Unit]
Description=DMIT private HY2 and REALITY proxy
After=network-online.target
Wants=network-online.target

[Service]
User=dmit-edge
Group=dmit-edge
ExecStart=__XRAY_BIN__ run -config /usr/local/etc/dmit-edge/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Example limits from a low-memory deployment; review before installing.
MemoryHigh=384M
MemoryMax=512M
Environment=GOMEMLIMIT=320MiB
UMask=0077

[Install]
WantedBy=multi-user.target
